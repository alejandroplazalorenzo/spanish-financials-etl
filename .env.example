# Copy to .env and change the placeholder values. .env is gitignored.

# PostgreSQL owner account (used by docker compose, migrations and the loader)
POSTGRES_DB=sfetl
POSTGRES_USER=sfetl_owner
POSTGRES_PASSWORD=change-me-owner
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=55432

# Passwords of the two login roles created by the migrations (`sfetl migrate` sets them):
#   sfetl_reader     analysts: base tables + curated views, read-only (migration 003/008)
#   sfetl_assistant  the assistant: curated views only + its own schema (migrations 008/009)
SFETL_READER_PASSWORD=change-me-reader
SFETL_ASSISTANT_PASSWORD=change-me-assistant

# LLM used by the assistant to route questions (and, as a flagged fallback, write SQL).
# ollama (default, local) or gemini (cloud; needs GEMINI_API_KEY).
SFETL_LLM_PROVIDER=ollama
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b
GEMINI_MODEL=gemini-flash-lite-latest
GEMINI_API_KEY=

# Optional Telegram adapter (`sfetl telegram`)
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_ALLOWED_IDS=
TELEGRAM_ADMIN_IDS=

# Contact string sent in the User-Agent to filings.xbrl.org and GLEIF (be a polite client)
SFETL_USER_AGENT=spanish-financials-etl/0.2 (portfolio project)
