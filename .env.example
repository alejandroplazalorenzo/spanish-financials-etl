# Copy to .env and change the placeholder values. .env is gitignored.

# PostgreSQL owner account (used by docker compose, migrations and the loader)
POSTGRES_DB=sfetl
POSTGRES_USER=sfetl_owner
POSTGRES_PASSWORD=change-me-owner
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=55432

# Password of the read-only login `sfetl_reader` (analysts and the `ask` command).
# `sfetl migrate` sets it on the role created by migration 003.
SFETL_READER_PASSWORD=change-me-reader

# Local LLM for `sfetl ask` (use 127.0.0.1, not localhost)
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b-instruct

# Contact string sent in the User-Agent to filings.xbrl.org (be a polite client)
SFETL_USER_AGENT=spanish-financials-etl/0.1 (portfolio project)
